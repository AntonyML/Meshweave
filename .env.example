# Variables que Meshweave consulta (las credenciales reales viven en el
# .env del backend o en el almacén DPAPI de Meshweave, nunca en el repo).

# ── Resend (alertas por email) ────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ADMIN_EMAIL=

# ── Supabase local (Docker) ───────────────────────────────────────────
# Ruta al .env del proyecto supabase (postgres user/password de Docker).
# Se referencia desde config.json (database.supabase_env), no se copia.
